# ---------------------------------------------------------------------------
# Secrets — never commit. Gitleaks runs in CI as a second line of defence.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
secrets/
credentials.json

# ---------------------------------------------------------------------------
# Java / Maven
# ---------------------------------------------------------------------------
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.properties.bak
*.class
*.log
hs_err_pid*
replay_pid*

# Gradle (in case a module ever uses it)
.gradle/
build/
!src/**/build/

