# ---------------------------------------------------------------------------
# Frontend environment.
#
#   cp .env.example .env.local
#
# .env.local is gitignored. Note the absence of a NEXT_PUBLIC_ prefix: this
# value is read on the server only and never reaches the browser bundle, which
# is exactly what we want for an internal service address.
# ---------------------------------------------------------------------------

# Where the Spring Boot platform is listening.
# In Kubernetes this becomes the in-cluster service name, e.g.
#   http://platform.opspilot.svc.cluster.local:8080
OPSPILOT_API_URL=http://localhost:8080
