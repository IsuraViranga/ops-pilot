# ---------------------------------------------------------------------------
# Local development environment.
#
#   cp .env.example .env
#
# .env is gitignored. These are throwaway local credentials, not secrets - but
# .env stays out of Git anyway, so that "put the password in .env" is the habit
# rather than something we start doing later when it actually matters.
#
# Production credentials come from AWS Secrets Manager. Never from a file.
# ---------------------------------------------------------------------------

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=opspilot

# Schema owner. Flyway migrations run as this role.
POSTGRES_USER=opspilot_migrator
POSTGRES_PASSWORD=local_migrator_pw

# The role the application connects as: NOSUPERUSER, NOBYPASSRLS.
# Row-Level Security applies to it, which is the whole point. See ADR-0002.
APP_DB_USER=opspilot_app
APP_DB_PASSWORD=local_app_pw

# --- Redis -----------------------------------------------------------------
REDIS_PASSWORD=local_redis_pw

# --- Host ports ------------------------------------------------------------
# Defaults avoid the standard ports, which are usually already taken by a
# locally installed Postgres, Redis or mail catcher. Change if these clash too.
POSTGRES_PORT=55432
REDIS_PORT=56379
MAILPIT_SMTP_PORT=51025
MAILPIT_UI_PORT=58025
ADMINER_PORT=58080
