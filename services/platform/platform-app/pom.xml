<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.opspilot</groupId>
        <artifactId>platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>platform-app</artifactId>
    <name>OpsPilot :: Application</name>
    <description>Composition root. The only module that knows about every other module, the only
        one that produces an executable jar, and the home of the ArchUnit tests that
        enforce the boundaries between all the others.</description>

    <dependencies>
        <!-- Every domain module. This is the one place the full list appears. -->
        <dependency>
            <groupId>com.opspilot</groupId>
            <artifactId>platform-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.opspilot</groupId>
            <artifactId>platform-identity</artifactId>
        </dependency>
        <dependency>
            <groupId>com.opspilot</groupId>
            <artifactId>platform-servicedesk</artifactId>
        </dependency>
        <dependency>
            <groupId>com.opspilot</groupId>
            <artifactId>platform-sla</artifactId>
        </dependency>
        <dependency>
            <groupId>com.opspilot</groupId>
            <artifactId>platform-workflow</artifactId>
        </dependency>
        <dependency>
            <groupId>com.opspilot</groupId>
            <artifactId>platform-asset</artifactId>
        </dependency>
        <dependency>
            <groupId>com.opspilot</groupId>
            <artifactId>platform-knowledge</artifactId>
        </dependency>
        <dependency>
            <groupId>com.opspilot</groupId>
            <artifactId>platform-audit</artifactId>
        </dependency>

        <!--
          Infrastructure starters live in the composition root rather than in the
          domain modules. A domain module that cannot see the web or persistence
          layer cannot accidentally depend on it.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!--
          Lettuce connection pooling needs this, and the Redis starter does not
          bring it in. Without it the application fails at startup with a bare
          NoClassDefFoundError for GenericObjectPoolConfig.
        -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!--
          Schema migrations.

          Spring Boot 4 split auto-configuration into per-technology modules, so
          flyway-core on the classpath is no longer enough to trigger it: without
          spring-boot-flyway, Flyway is silently never invoked. The application
          starts, /actuator/health reports UP, and the schema is simply empty.
          That failure mode is why Part 6 asserts the migration ran.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Exposes /actuator/prometheus for the Phase 7 monitoring stack. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          ArchUnit lives here because boundary rules are only meaningful when every
          module is on the same classpath. Rules arrive in Part 6.
        -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
        </dependency>

        <!--
          Integration tests run against real PostgreSQL and Redis containers.
          Never H2: a database you do not deploy gives you false confidence,
          and none of Row-Level Security, JSONB or citext exists there at all.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Produces the executable fat jar and the OCI image build. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
