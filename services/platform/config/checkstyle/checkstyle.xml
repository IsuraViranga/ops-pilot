<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  OpsPilot Checkstyle configuration.

  Scope: correctness and readability only. Formatting (indentation, line wrapping,
  import order, whitespace) is owned by Spotless + Palantir Java Format and is
  deliberately NOT duplicated here - two tools with opinions about the same thing
  is a build that can never be made green.

  Severity is `warning`, and the Maven plugin is configured with
  violationSeverity=warning, so every rule below fails the build.
-->
<module name="Checker">
    <property name="severity" value="warning"/>
    <property name="charset" value="UTF-8"/>
    <property name="fileExtensions" value="java, properties, xml"/>

    <!-- Path is injected by maven-checkstyle-plugin from <suppressionsLocation>. -->
    <module name="SuppressionFilter">
        <property name="file" value="${checkstyle.suppressions.file}" default=""/>
        <property name="optional" value="true"/>
    </module>

    <!-- Allow targeted opt-outs: // CHECKSTYLE.OFF: RuleName ... // CHECKSTYLE.ON: RuleName -->
    <module name="SuppressWithPlainTextCommentFilter">
        <property name="offCommentFormat" value="CHECKSTYLE.OFF\: ([\w\|]+)"/>
        <property name="onCommentFormat" value="CHECKSTYLE.ON\: ([\w\|]+)"/>
        <property name="checkFormat" value="$1"/>
    </module>

    <!-- ===================== File-level ===================== -->

    <module name="NewlineAtEndOfFile"/>

    <module name="FileLength">
        <property name="max" value="800"/>
    </module>

    <!-- Tabs render differently everywhere; .editorconfig mandates spaces. -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- Someone has to read this in a side-by-side diff. -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^package .*|^import .*|^\s*\*.*https?://|@see\s"/>
    </module>

    <!-- A TODO with no owner is a TODO nobody will ever do. -->
    <module name="RegexpSingleline">
        <property name="format" value="\b(TODO|FIXME)\b(?!\s*\()"/>
        <property name="message"
                  value="TODO/FIXME must name an owner or issue, e.g. TODO(#42): reason"/>
        <property name="severity" value="warning"/>
    </module>

    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="Trailing whitespace"/>
    </module>

    <!--
      Every package carries a package-info.java documenting its purpose and its
      boundary contract. This is a file-level check, so it sits outside TreeWalker.
    -->
    <module name="JavadocPackage"/>

    <module name="TreeWalker">

        <!-- ===================== Naming ===================== -->

        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="StaticVariableName"/>
        <module name="ConstantName"/>
        <module name="ClassTypeParameterName"/>
        <module name="MethodTypeParameterName"/>
        <module name="RecordComponentName"/>
        <module name="PatternVariableName"/>
        <module name="LambdaParameterName"/>

        <!-- ===================== Imports ===================== -->

        <module name="UnusedImports">
            <property name="processJavadoc" value="true"/>
        </module>
        <module name="RedundantImport"/>
        <module name="AvoidStarImport"/>

        <!--
          Boundary enforcement, first line of defence. ArchUnit does the thorough
          job; this gives a faster, clearer failure at compile time.
        -->
        <module name="IllegalImport">
            <property name="illegalPkgs"
                      value="sun, com.sun, jdk.internal, org.apache.commons.lang, junit.framework"/>
        </module>

        <!-- java.util.logging and System.out are not the logging strategy. -->
        <module name="IllegalImport">
            <property name="id" value="BanJavaUtilLogging"/>
            <property name="illegalPkgs" value="java.util.logging"/>
        </module>

        <module name="Regexp">
            <property name="format" value="System\.(out|err)\.print"/>
            <property name="illegalPattern" value="true"/>
            <property name="message" value="Use a logger, not System.out/System.err"/>
        </module>

        <!-- ===================== Correctness ===================== -->

        <!-- A single-statement if without braces is how bugs are introduced. -->
        <module name="NeedBraces"/>
        <module name="LeftCurly"/>
        <module name="RightCurly"/>

        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignored"/>
        </module>
        <module name="EmptyStatement"/>

        <module name="EqualsHashCode"/>
        <module name="CovariantEquals"/>
        <module name="EqualsAvoidNull"/>
        <module name="StringLiteralEquality"/>

        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>

        <module name="MissingSwitchDefault"/>
        <module name="FallThrough"/>
        <module name="DefaultComesLast"/>

        <module name="IllegalThrows"/>
        <module name="IllegalCatch">
            <property name="illegalClassNames"
                      value="java.lang.Error, java.lang.Throwable"/>
        </module>

        <module name="NoFinalizer"/>
        <module name="SuperClone"/>
        <module name="OneStatementPerLine"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="ModifiedControlVariable"/>
        <module name="NestedTryDepth">
            <property name="max" value="2"/>
        </module>
        <module name="IllegalTokenText">
            <property name="tokens" value="STRING_LITERAL, CHAR_LITERAL"/>
            <property name="format"
                      value="\\u00(09|0(a|A)|0(c|C)|0(d|D)|22|27|5(C|c))|\\(0(10|11|12|14|15|42|47)|134)"/>
            <property name="message" value="Consider using a special escape sequence instead"/>
        </module>

        <!-- ===================== Design ===================== -->

        <!--
          Public mutable static state is a correctness hazard in a multi-tenant
          system - it is shared across every request and every tenant.
        -->
        <module name="VisibilityModifier">
            <property name="protectedAllowed" value="true"/>
            <property name="allowPublicFinalFields" value="true"/>
        </module>

        <module name="FinalClass"/>
        <module name="HideUtilityClassConstructor"/>
        <module name="InterfaceIsType"/>
        <module name="MutableException"/>
        <module name="OneTopLevelClass"/>

        <!-- ===================== Complexity ===================== -->

        <!-- These thresholds are deliberately generous; they catch outliers only. -->
        <module name="CyclomaticComplexity">
            <property name="max" value="12"/>
        </module>
        <module name="NPathComplexity">
            <property name="max" value="200"/>
        </module>
        <module name="MethodLength">
            <property name="max" value="80"/>
            <property name="countEmpty" value="false"/>
        </module>
        <module name="ParameterNumber">
            <property name="max" value="8"/>
            <property name="ignoreOverriddenMethods" value="true"/>
        </module>
        <module name="BooleanExpressionComplexity">
            <property name="max" value="5"/>
        </module>
        <module name="ClassFanOutComplexity">
            <property name="max" value="25"/>
        </module>

        <!-- ===================== Documentation ===================== -->

        <!--
          Javadoc is required where it earns its keep: public API types and the
          package-info that documents a module boundary. Not on every getter.
        -->
        <module name="JavadocType">
            <property name="scope" value="public"/>
            <property name="allowMissingParamTags" value="true"/>
        </module>
        <!-- Replaces the JavadocStyle check removed in Checkstyle 11. -->
        <module name="SummaryJavadoc">
            <property name="violateExecutionOnNonTightHtml" value="false"/>
        </module>
        <module name="JavadocParagraph"/>
        <module name="JavadocMissingWhitespaceAfterAsterisk"/>
        <module name="NonEmptyAtclauseDescription"/>
        <module name="InvalidJavadocPosition"/>

        <!-- ===================== Annotations ===================== -->

        <module name="MissingOverride"/>
        <module name="AnnotationLocation"/>
        <module name="PackageAnnotation"/>

        <!-- ===================== Modifiers ===================== -->

        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>

        <!-- ===================== Misc ===================== -->

        <module name="ArrayTypeStyle"/>
        <module name="UpperEll"/>
        <module name="OuterTypeFilename"/>
        <module name="TodoComment">
            <property name="format" value="(XXX|HACK)"/>
            <property name="severity" value="warning"/>
        </module>

    </module>
</module>
