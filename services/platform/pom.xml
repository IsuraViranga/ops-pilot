<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
      Inherit from spring-boot-starter-parent for curated dependency versions and
      sensible plugin defaults. Everything project-specific is configured below.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath />
    </parent>

    <groupId>com.opspilot</groupId>
    <artifactId>platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>OpsPilot Platform</name>
    <description>Modular monolith for the OpsPilot enterprise service management platform.
        Each module is an independent bounded context with boundaries enforced at
        build time by ArchUnit. See docs/adr/0001-modular-monolith.md.</description>

    <!--
      Module order is the dependency order. platform-common is the shared kernel;
      the domain modules depend only on it; platform-app wires everything together
      and is the only module that produces an executable jar.
    -->
    <modules>
        <module>platform-common</module>
        <module>platform-identity</module>
        <module>platform-servicedesk</module>
        <module>platform-sla</module>
        <module>platform-workflow</module>
        <module>platform-asset</module>
        <module>platform-knowledge</module>
        <module>platform-audit</module>
        <module>platform-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Minimum build tooling -->
        <required.maven.version>3.9.0</required.maven.version>

        <!-- Library versions not managed by the Spring Boot BOM -->
        <archunit.version>1.5.0</archunit.version>
        <mapstruct.version>1.6.3</mapstruct.version>

        <!-- Build plugin versions - pinned so the build is reproducible -->
        <spotless.version>3.10.2</spotless.version>
        <palantir-java-format.version>2.98.0</palantir-java-format.version>
        <checkstyle.plugin.version>3.6.0</checkstyle.plugin.version>
        <checkstyle.version>14.1.0</checkstyle.version>
        <jacoco.version>0.8.15</jacoco.version>
        <enforcer.version>3.6.3</enforcer.version>

        <!-- Quality gate -->
        <jacoco.line.coverage>0.75</jacoco.line.coverage>

        <!-- Shared configuration location, resolved from any module depth -->
        <config.dir>${maven.multiModuleProjectDirectory}/config</config.dir>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules: declared once here, version-free everywhere else -->
            <dependency>
                <groupId>com.opspilot</groupId>
                <artifactId>platform-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.opspilot</groupId>
                <artifactId>platform-identity</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.opspilot</groupId>
                <artifactId>platform-servicedesk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.opspilot</groupId>
                <artifactId>platform-sla</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.opspilot</groupId>
                <artifactId>platform-workflow</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.opspilot</groupId>
                <artifactId>platform-asset</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.opspilot</groupId>
                <artifactId>platform-knowledge</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.opspilot</groupId>
                <artifactId>platform-audit</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Third-party not covered by the Spring Boot BOM -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Dependencies every module gets, without repeating them nine times -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>${checkstyle.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${enforcer.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
              Annotation processors. Order matters: Lombok must run before MapStruct,
              otherwise MapStruct cannot see Lombok-generated getters and setters.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                    <compilerArgs>
                        <arg>-Xlint:all,-processing,-serial</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!--
              Fail fast on a misconfigured environment, so the error message is
              "you need Java 21" rather than a confusing compilation failure.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[${required.maven.version},)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[${java.version},)</version>
                                </requireJavaVersion>
                                <!-- A release build must not depend on moving targets -->
                                <requireReleaseDeps>
                                    <message>No SNAPSHOT dependencies are allowed.</message>
                                    <onlyWhenRelease>true</onlyWhenRelease>
                                </requireReleaseDeps>
                                <banDuplicatePomDependencyVersions />
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              Spotless formats; it does not judge. Bound to validate so a badly
              formatted file fails immediately rather than after a long build.
              Run `./mvnw spotless:apply` to fix everything automatically.
            -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <configuration>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <!-- Palantir: Google Java Format with 4-space indent and a
                             120-column limit, which matches .editorconfig -->
                        <palantirJavaFormat>
                            <version>${palantir-java-format.version}</version>
                        </palantirJavaFormat>
                        <removeUnusedImports />
                        <importOrder>
                            <order>java,javax,jakarta,org,com,</order>
                        </importOrder>
                        <trimTrailingWhitespace />
                        <endWithNewline />
                        <formatAnnotations />
                    </java>
                    <pom>
                        <sortPom>
                            <!-- Match .editorconfig: 4 spaces, and keep the blank lines
                                 and comments that make a 400-line POM navigable. -->
                            <nrOfIndentSpace>4</nrOfIndentSpace>
                            <keepBlankLines>true</keepBlankLines>
                            <indentSchemaLocation>true</indentSchemaLocation>
                            <expandEmptyElements>false</expandEmptyElements>
                            <spaceBeforeCloseEmptyElement>true</spaceBeforeCloseEmptyElement>
                            <!-- Declaration order is meaningful to us: modules are listed
                                 in dependency order, dependencies grouped by purpose. -->
                            <sortModules>false</sortModules>
                            <sortDependencies />
                            <sortPlugins />
                            <sortProperties>false</sortProperties>
                            <sortExecutions>false</sortExecutions>
                        </sortPom>
                    </pom>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>validate</phase>
                    </execution>
                </executions>
            </plugin>

            <!--
              Checkstyle catches what a formatter cannot: naming, complexity,
              missing braces, empty catch blocks, equals without hashCode.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <configuration>
                    <configLocation>${config.dir}/checkstyle/checkstyle.xml</configLocation>
                    <suppressionsLocation>${config.dir}/checkstyle/suppressions.xml</suppressionsLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <consoleOutput>true</consoleOutput>
                    <failsOnError>true</failsOnError>
                    <violationSeverity>warning</violationSeverity>
                    <linkXRef>false</linkXRef>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>checkstyle-validate</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>validate</phase>
                    </execution>
                </executions>
            </plugin>

            <!-- Unit tests: *Test. Fast, no Spring context, no containers. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Integration tests: *IT. Testcontainers, real Postgres and Redis. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <id>integration-tests</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Coverage. Excludes code with no logic worth asserting on. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/*Application.class</exclude>
                        <exclude>**/config/**</exclude>
                        <exclude>**/dto/**</exclude>
                        <exclude>**/*MapperImpl.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                    <execution>
                        <id>check-coverage</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.coverage}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          `./mvnw -Pfast` - skip the quality gates during a tight edit-compile loop.
          CI never uses this profile.
        -->
        <profile>
            <id>fast</id>
            <properties>
                <spotless.check.skip>true</spotless.check.skip>
                <checkstyle.skip>true</checkstyle.skip>
                <jacoco.skip>true</jacoco.skip>
                <skipITs>true</skipITs>
            </properties>
        </profile>
    </profiles>

</project>
