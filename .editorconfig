# EditorConfig — keeps formatting identical across IntelliJ, VS Code and any editor.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

# Java — Google Java Format uses 2-space indent but 4 is the Spring convention.
# This must match the Spotless configuration added in Part 3.
[*.java]
indent_size = 4

[*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css,scss}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 88

[*.{tf,tfvars}]
indent_size = 2

[*.{xml,html}]
indent_size = 2

[*.sql]
indent_size = 2

[*.md]
indent_size = 2
# Two trailing spaces are a hard line break in Markdown — do not strip them.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Generated / vendored — leave exactly as the tool wrote them.
[{package-lock.json,pnpm-lock.yaml,poetry.lock}]
insert_final_newline = false
trim_trailing_whitespace = false
